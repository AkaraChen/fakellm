{
  "name": "fakellm",
  "version": "0.1.0",
  "description": "Spawn and control a fakellm fake LLM API server from JS/TS tests",
  "private": false,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
