{
  "name": "@fakellm/native",
  "version": "0.1.0",
  "description": "An in-memory fake LLM API server (OpenAI Chat/Responses, Anthropic Messages) for tests, running inside your Node.js process",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/fakellm.git",
    "directory": "bindings/node"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "fake",
    "mock",
    "test",
    "in-memory"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "fakellm-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "test": "node --expose-gc --test __test__/openai.test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@napi-rs/cli": "^3.10.9",
    "openai": "^7.47.0"
  }
}
